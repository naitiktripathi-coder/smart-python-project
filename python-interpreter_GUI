import tkinter as tk
import os
#window_specification-----

root= tk.Tk()
root.geometry("800x400")
root.config(bg="grey")

#key-components-----

write_label=tk.Text(root,bg="lavender",fg="black",font=("Arial",8))
write_label.place(relx=0,rely=0)
error_label= tk.Label(root,text="",fg="maroon",bg="grey")
error_label.place(relx=0.1,rely=0.7)
letter=tk.IntVar()
pad=tk.IntVar()
check= tk.IntVar()
#savefile
def save_file() :
	new= tk.Toplevel(root)
	new.geometry("400x500")
	new.config(bg="black")
	new.title("SAVE FILE")
		
	pas_name= tk.Entry(new)
	pas_name.place(relx=0.1,rely=0.1)
		
	def create_file() :
		code = write_label.get("1.0",tk.END)
		file_name= pas_name.get().strip()
		tab= (os.getcwd())
		
		
		if len(file_name)== 0 :
			error_label.config(text= "please write the file name")
			return
		with open("/storage/emulated/0/Android/data/ai.perplexity.app.android/"+file_name+".py","w") as real_file :
			real_file.write(code)
			error_label.config(text="FILE SAVED \n Path : \n"+tab)
	file_creation= tk.Button(new,text="CREATE",command=create_file)
	file_creation.place(relx=0.1,rely=0.3)
file_mfg= tk.Button(root,text="   SAVE   ",bg="magenta",fg="white",command=save_file)
file_mfg.place(relx=0.05,rely=0.839)
#open_file
def open_file() :
	op= tk.Toplevel(root)
	op.title("OPEN FILE")
	op.geometry("400x800")
	op.config(bg="cyan")
	
	op_entry= tk.Entry(op)
	op_entry.place(relx=0.1,rely=0.1)
	
	def open_it():
		ope_name= op_entry.get().strip()
		if pad.get()== 1 :
			error_label.config(text="ERROR : Firstly enable the writing\n area by disabling the Pad\n Lock from the SETTING ")
			return
		if len(ope_name)==0 :
			error_label.config(text="please write the file name")
			return
		try :
			with open("/storage/emulated/0/Android/data/ai.perplexity.app.android/"+ope_name+".py","r") as files :
				code= files.read()
				write_label.delete("1.0",tk.END)
				write_label.insert("1.0",code)
				error_label.config(text="OPENED SUCCESSFULLY")
		except FileNotFoundError :
			error_label.config(text= " ERROR : File Not Found")
	pl_button= tk.Button(op,command=open_it,text="OPEN",fg="cyan",bg="blue")
	pl_button.place(relx=0.1,rely=0.4)

bl_button= tk.Button(root,text="OPEN ",fg="cyan",bg="blue",command=open_file)
bl_button.place(relx=0.7,rely=0.839)
			
	
#function-----
def setting() :
	win= tk.Toplevel(root)
	win.geometry("700x1300")
	win.config(bg="white")
	win.title("Setting")
	#exit_button
	def exit_btn() :
		ex= tk.Toplevel(win)
		ex.config(bg="white")
		ex.title("WARNING")
		ex.geometry("600x600")
		warn_label= tk.Label(ex,text=" Do you really want to exit \n from the enterpreter ?",fg="red",bg="white")
		warn_label.place(relx=0.1,rely=0.2)
		ex_button= tk.Button(ex,text="YES",fg="white",bg="red",command= root.destroy)
		ex_button.place(relx=0.15,rely=0.4)
		cancel_button= tk.Button(ex,text="NO",fg="white",bg="blue",command= ex.destroy)
		cancel_button.place(relx=0.45,rely=0.4)
		
	exit_button= tk.Button(win,text="EXIT",fg="white",bg="red",command= exit_btn)
	exit_button.place(relx=0.4,rely=0.8)
	#mode-----
	
	mode_label= tk.Label(win,text="--Mode----------",fg="blue",bg="white",font=("Arial",10,"bold"))
	mode_label.place(relx=0.1,rely=0.05)
	
	def dark_mode() :
		if check.get()== 1 :
			write_label.config(bg="black",fg="white")
		
		else :
			write_label.config(bg="lavender",fg="black")
	mode= tk.Checkbutton(win,text="Dark Mode",variable=check,command= dark_mode,bg="skyblue")
	mode.place(relx=0.1,rely=0.1)
	

	lock_label= tk.Label(win,text="--Lock-----------",fg="blue",bg="white",font=("Arial",10,"bold"))
	lock_label.place(relx=0.1,rely=0.15)	
	def lock_pad() :
		if pad.get()== 1 :
			write_label.config(state="disabled")
		else :
			write_label.config(state="normal")
	lock= tk.Checkbutton(win,text="Lock the Writing Pad",variable=pad,command= lock_pad,bg="skyblue")
	lock.place(relx=0.1,rely=0.2)
################################		
	font_label= tk.Label(win,text="--Font Style-----",fg="blue",bg="white",font=("Arial",10,"bold"))
	font_label.place(relx=0.1,rely=0.25)
	def font_style() :
		if letter.get()== 1 :
			write_label.config(font=("Arial",8,"italic"))
		else :
			write_label.config(font=("Arial",8))
	font= tk.Checkbutton(win,text="Italic",variable=letter,command= font_style,bg="skyblue")
	font.place(relx=0.1,rely=0.3)
		
def clear() :
	write_label.delete("1.0",tk.END)
def code_execute() :
	error_label.config(text="Running.....")
	code= write_label.get("1.0",tk.END)
	try :
		final=exec(code)
		error_label.config(text="Code Executed Successfully")
	except Exception as e :
		error_label.config(text=f" ERROR : {e}")

#Components-----
run_button= tk.Button(root,text="EXECUTE",command=code_execute,fg="white",bg="darkblue")
run_button.place(relx=0.37,rely=0.9)
clear_button= tk.Button(root,text="CLEAR",command=clear,fg="black",bg="yellow")
clear_button.place(relx=0.7,rely=0.9)
setting_button= tk.Button(root,text="SETTING",command=setting,fg="white",bg="brown")
setting_button.place(relx=0.05,rely=0.9)
#window_runner-----
root.mainloop()	













